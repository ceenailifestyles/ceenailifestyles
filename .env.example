# ==============================================================================
# CEENAI LIFESTYLES - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Fill in real values on your server or in your local .env file.
# Never commit real secrets or credentials to source control.
# ==============================================================================

# Database Connection (Server-only)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=

# Authentication Secret (Server-only)
# Generate a strong 32+ character random string for signing JWT tokens
AUTH_SECRET=

# Application Base URL (Client & Build-time)
# e.g., https://ceenai.com or http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Cloudinary Media Storage (Server-only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudinary Public Cloud Name (Client & Build-time)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Brevo (Sendinblue) Transactional Emails (Server-only)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Razorpay Payment Gateway (Server-only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Payment Gateway (Client & Build-time)
# Matches RAZORPAY_KEY_ID for client-side checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=
